# LeadPulse AI — Environment Configuration
# Copy this to .env and fill in your credentials

# Database (PostgreSQL via asyncpg)
DATABASE_URL=postgresql+asyncpg://leadpulse:leadpulse_secret@db:5432/leadpulse

# Meta / WhatsApp Cloud API
META_VERIFY_TOKEN=leadpulse_verify_token_secure_123
META_APP_SECRET=your_meta_app_secret_here

# AI Brain (Claude API)
# This is the system default; each tenant can provide their own key in Settings
CLAUDE_API_KEY=your_anthropic_api_key_here

# Email Delivery (Resend - 3,000 free emails/mo)
RESEND_API_KEY=your_resend_api_key_here

# Instant Alerts (Telegram Bot)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# JWT Security
JWT_SECRET_KEY=generate_a_random_64_character_hex_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440
